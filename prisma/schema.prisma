// Meridyen Danışmanlık — kurumsal danışmanlık web sitesi veri modeli
generator client {
  provider = "prisma-client-js"
  // native = yerel geliştirme; debian = Docker imajı (node:slim).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  // Yerel geliştirme: SQLite. Production'da bu satır "postgresql" olabilir.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Durumlar ───────────────────────────

enum Role {
  ADMIN // site yöneticisi
  EDITOR // içerik editörü (blog/hizmet)
}

enum MessageStatus {
  NEW // yeni gelen
  READ // okundu
  REPLIED // yanıtlandı
  ARCHIVED // arşivlendi
}

enum AppointmentStatus {
  PENDING // talep alındı
  CONFIRMED // onaylandı
  CANCELLED // iptal
  COMPLETED // tamamlandı
}

// ─────────────────────────── Yönetici kullanıcılar ───────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
}

// ─────────────────────────── Hizmetler ───────────────────────────

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String // kısa açıklama (kart/liste)
  description String // uzun açıklama (detay sayfası, paragraflar \n\n ile)
  icon        String   @default("Briefcase") // lucide ikon adı
  features    String   @default("") // satır başı (\n) ile ayrılmış maddeler
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages     ContactMessage[]
  appointments Appointment[]
}

// ─────────────────────────── Blog / Makaleler ───────────────────────────

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String // özet
  content     String // gövde (paragraflar \n\n ile; "## " ile alt başlık)
  coverImage  String?
  author      String    @default("Meridyen Ekibi")
  category    String? // "İş Dünyası", "Vergi", "Göçmenlik", "Teknoloji"
  published   Boolean   @default(true)
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─────────────────────────── Ekip ───────────────────────────

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  title     String // ünvan
  bio       String?
  photo     String?
  email     String?
  linkedin  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ─────────────────────────── İletişim / Teklif mesajları ───────────────────────────

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String? // başvuranın firması
  subject   String?
  message   String
  // Hangi hizmetle ilgili (opsiyonel)
  service   Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId String?
  kind      String        @default("contact") // contact | quote (teklif)
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status])
}

// ─────────────────────────── Randevular ───────────────────────────

model Appointment {
  id        String            @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId String?
  // Seçilen tarih + saat (tek alan; slot başlangıcı)
  slot      DateTime
  note      String?
  status    AppointmentStatus @default(PENDING)
  createdAt DateTime          @default(now())

  // Çift rezervasyon uygulama seviyesinde engellenir (iptal edilen slot tekrar açılabilsin).
  @@index([slot])
  @@index([status])
}
