{
  "name": "danismanlik-sitesi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "gen:seed": "node --env-file=.env scripts/gen-d1-sql.mjs",
    "d1:schema:local": "wrangler d1 execute prokosova-db --local --file=cloudflare/schema.sql",
    "d1:seed:local": "wrangler d1 execute prokosova-db --local --file=cloudflare/seed.sql",
    "d1:schema": "wrangler d1 execute prokosova-db --remote --file=cloudflare/schema.sql",
    "d1:seed": "wrangler d1 execute prokosova-db --remote --file=cloudflare/seed.sql"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.150.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
