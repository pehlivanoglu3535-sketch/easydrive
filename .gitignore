# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — gerçek .env gizli; örnek şablonlar commit'lenir
.env*
!.env.example
!.env.production.example

# yerel veritabanı (SQLite) — asla commit'lenmez
/prisma/*.db
/prisma/*.db-journal

# yüklenen dosyalar (logo/foto/imza) — çalışma zamanında oluşur, kalıcı volume'da tutulur
/public/uploads/*
!/public/uploads/.gitkeep

# geliştirme logları
/.devlog

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudflare / OpenNext
/.open-next/
/.wrangler/
cloudflare-env.d.ts

# Prisma generated client (build sırasında üretilir)
/src/generated/

# wrangler local secrets
.dev.vars
