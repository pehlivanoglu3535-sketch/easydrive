# ─── RentFlow production (Docker Compose) ───
# Bu dosyayı .env olarak kopyalayın ve doldurun:  cp .env.production.example .env

# Postgres kimlik bilgileri (compose bunları hem db hem app için kullanır).
POSTGRES_USER=rentflow
POSTGRES_PASSWORD=GÜÇLÜ_BİR_ŞİFRE_YAZIN
POSTGRES_DB=rentflow

# Oturum imzalama anahtarı — ZORUNLU. Üretin:  openssl rand -base64 48
AUTH_SECRET=

# İlk açılışta oluşturulacak SÜPER ADMIN (bir kez kullanılır; sonra bu satırları boşaltabilirsiniz).
SUPER_ADMIN_EMAIL=admin@senindomainin.com
SUPER_ADMIN_PASSWORD=İLK_GİRİŞ_ŞİFRESİ
SUPER_ADMIN_NAME=Platform Yöneticisi

# Uygulamanın host portu (varsayılan 3000). Reverse proxy arkasındaysa değiştirebilirsiniz.
APP_PORT=3000

# Otomatik HTTPS için domain (Caddy). DNS A kaydı bu domaini sunucu IP'sine yönlendirmeli.
# Caddy'yi başlatmak için:  docker compose --profile proxy up -d
DOMAIN=easydriveks.com

# NOT: DATABASE_URL compose tarafından otomatik kurulur (app servisi → db servisi).
# Compose DIŞINDA (harici Postgres) çalıştıracaksanız DATABASE_URL'i elle verin:
# DATABASE_URL=postgresql://kullanici:sifre@host:5432/rentflow?schema=public
