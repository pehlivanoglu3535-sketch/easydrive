# ─── RentFlow — YEREL geliştirme (SQLite) ───
# Bu dosya yerel geliştirme içindir. Production için: .env.production.example → DEPLOY.md

DATABASE_URL="file:./dev.db"

# Oturum imzalama anahtarı (yerelde herhangi bir değer; production'da ZORUNLU + güçlü):
AUTH_SECRET="dev-secret-degistir"

# (Opsiyonel) yükleme klasörünü değiştirmek için — varsayılan public/uploads:
# UPLOAD_DIR=""

# NOT: Production'da Postgres'e geçiş, dosya depolama ve Docker kurulumu OTOMATİKTİR.
# schema.prisma'yı elle değiştirmenize gerek yok — bkz. DEPLOY.md (docker compose up).
