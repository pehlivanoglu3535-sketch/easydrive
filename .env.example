# ─── Meridyen Danışmanlık — YEREL geliştirme (SQLite) ───
# Bu dosya yerel geliştirme içindir. Production için: .env.production.example + DEPLOY.md

DATABASE_URL="file:./dev.db"

# Oturum imzalama anahtarı (yerelde herhangi bir değer; production'da ZORUNLU + güçlü):
# Üretmek için: openssl rand -base64 48
AUTH_SECRET="dev-secret-degistir"

# Seed ile oluşturulacak yönetici (opsiyonel; verilmezse varsayılan kullanılır):
# SEED_ADMIN_EMAIL="admin@meridyendanismanlik.com"
# SEED_ADMIN_PASSWORD="admin1234"
