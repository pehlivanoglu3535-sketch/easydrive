# Meridyen Danışmanlık — otomatik HTTPS (Let's Encrypt).
# Domain .env'deki DOMAIN'den gelir. Tek siteli (çoklu kiracı/subdomain yok).

# www → köke kalıcı yönlendirme.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Kök domain → uygulama.
{$DOMAIN} {
	encode gzip
	reverse_proxy app:3000
}
