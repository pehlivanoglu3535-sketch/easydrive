# RentFlow — otomatik HTTPS (Let's Encrypt). Domain .env'deki DOMAIN'den gelir.

# On-demand TLS: firma subdomain'leri için sertifikayı ilk erişimde alır.
# "ask" ucu yalnızca gerçek firmalara izin verir (kötüye kullanım önlemi).
{
	on_demand_tls {
		ask http://app:3000/api/tls-check
	}
}

# Kök domain → uygulama.
{$DOMAIN} {
	encode gzip
	reverse_proxy app:3000
}

# www → kök domaine kalıcı yönlendirme (kanonik adres).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Firma subdomain'leri: <firma>.easydriveks.com → uygulama (middleware /s/<firma>'ya eşler).
*.{$DOMAIN} {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy app:3000
}
