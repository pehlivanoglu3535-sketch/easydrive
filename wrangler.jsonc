{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prokosova-solutions",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  // Cloudflare D1 (SQLite) — veri Cloudflare'de saklanır.
  // database_id'yi kendi D1 veritabanınızın ID'siyle değiştirin (wrangler d1 create ... çıktısı).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prokosova-db",
      "database_id": "f433332b-d500-4cef-855d-d401b193bc2f"
    }
  ],
  // Cloudflare R2 (nesne depolama) — başvuru belgeleri (pasaport, sabıka, fatura) burada saklanır.
  // Cloudflare panelinde "prokosova-uploads" adında bir R2 bucket oluşturup bu binding'i bağlayın.
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "prokosova-uploads"
    }
  ]
}
